<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The log's console handle and the window frames call the system through LibraryImport. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The program's icon on Windows (tools/app-icon.py draws it). -->
    <ApplicationIcon>Shell/Assets/wayfarer.ico</ApplicationIcon>
    <!-- Windows makes a layered child window only for a program whose manifest names Windows 8 or later; the docked tool windows need one. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <!-- The window's typeface (Shell/Theme/WindowFonts.cs), Inter's hinted faces, and the looks Wayfarer carries. -->
    <AvaloniaResource Include="Shell/Fonts/*.ttf" />
    <AvaloniaResource Include="Shell/Assets/wayfarer.ico;Shell/Assets/wayfarer.png" />
    <AvaloniaResource Include="Shell/Assets/FirstStart/*.webp" />
    <AvaloniaResource Include="Shell/Theme/BuiltIn/**/*.json" />
    <Content Include="../../templates/jvm/**/*" Link="templates/jvm/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../vendor/passenger/THIRD_PARTY_NOTICES.md;../../vendor/passenger/LICENSE;../../vendor/passenger/src/Passenger.Editor/Fonts/OFL.txt"
          Link="notices/Passenger/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The TextMate grammars that colour Wayfarer's languages (Shell/Languages/Language.cs), VS Code's files unchanged,
         read by their file name; Shell/Languages/NOTICES.md says where each came from. -->
    <EmbeddedResource Include="../../vendor/passenger/src/Passenger.Languages/TextMate/Grammars/java.tmLanguage.json;
                               ../../vendor/passenger/src/Passenger.Languages/TextMate/Grammars/Kotlin.tmLanguage.json;
                               ../../vendor/passenger/src/Passenger.Languages/TextMate/Grammars/groovy.tmLanguage.json;
                               ../../vendor/passenger/src/Passenger.Languages/TextMate/Grammars/xml.tmLanguage.json;
                               ../../vendor/passenger/src/Passenger.Languages/TextMate/Grammars/yaml*.tmLanguage.json;
                               ../../vendor/passenger/src/Passenger.Languages/TextMate/Grammars/ini.tmLanguage.json;
                               ../../vendor/passenger/src/Passenger.Languages/TextMate/Grammars/JSON.tmLanguage.json;
                               ../../vendor/passenger/src/Passenger.Languages/TextMate/Grammars/markdown.tmLanguage.json;
                               ../../vendor/passenger/src/Passenger.Languages/TextMate/Grammars/shell-unix-bash.tmLanguage.json;
                               ../../vendor/passenger/src/Passenger.Languages/TextMate/Grammars/gitattributes.tmLanguage.json"
                      LogicalName="Grammars/%(Filename)%(Extension)" Link="Shell/Languages/Grammars/%(Filename)%(Extension)" />
    <None Include="Shell/Languages/NOTICES.md;../../vendor/passenger/tools/Passenger.Notices/Licenses/MIT.txt;../../vendor/passenger/tools/Passenger.Notices/Licenses/Apache-2.0.txt;../../vendor/passenger/tools/Passenger.Notices/Licenses/EPL-2.0.txt"
          Link="notices/SyntaxColours/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Tint" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Velopack" />
    <ProjectReference Include="../WayfarerWanderer.Jvm/WayfarerWanderer.Jvm.csproj" />
    <ProjectReference Include="../../vendor/passenger/src/Passenger.Editor/Passenger.Editor.csproj" />
    <ProjectReference Include="../../vendor/passenger/src/Passenger.Terminal/Passenger.Terminal.csproj" />
    <ProjectReference Include="../../vendor/passenger/src/Passenger.Vcs/Passenger.Vcs.csproj" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.HarfBuzz" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="HarfBuzzSharp" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
  </ItemGroup>
</Project>
